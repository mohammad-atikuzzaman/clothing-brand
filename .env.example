# ==============================================================================
# IZHAAN LIFESTYLE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env.local' and update values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB)
# ------------------------------------------------------------------------------
# Primary MongoDB Connection URI (Local or MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/izhaan?appName=Cluster0
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/izhaan?appName=Cluster0

# Connection pool limit (Recommended: 50 for production, 10 for development)
MONGODB_MAX_POOL_SIZE=50

# Optional: Migration Script Variables (Used by scripts/migrate-local-to-atlas.mjs)
LOCAL_MONGODB_URI=mongodb://127.0.0.1:27017
LOCAL_DB_NAME=clothing_brand
ATLAS_URI=
ATLAS_DB_NAME=izhaan

# ------------------------------------------------------------------------------
# 2. APPLICATION URL & CANONICAL DOMAIN
# ------------------------------------------------------------------------------
# Base URL used for metadata, sitemaps, OpenGraph cards, and CAPI events
# Dev: http://localhost:3000 | Production: https://izhaanlifestyle.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & ADMIN INITIALIZATION
# ------------------------------------------------------------------------------
# 32+ character random secret for JWT signing & session verification
# Generate one via terminal: openssl rand -hex 32
AUTH_SECRET=your_super_secret_auth_key_at_least_32_characters_long

# Initial Super Admin credentials (used only on first startup if no admin exists)
INITIAL_ADMIN_EMAIL=admin@izhaanlifestyle.com
INITIAL_ADMIN_PASSWORD=YourStrongAdminPassword123!

# ------------------------------------------------------------------------------
# 4. CLOUDINARY MEDIA STORAGE (Product & Banner Images)
# ------------------------------------------------------------------------------
# Obtain from Cloudinary Dashboard: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ------------------------------------------------------------------------------
# 5. META (FACEBOOK) PIXEL & CONVERSIONS API (CAPI)
# ------------------------------------------------------------------------------
# Meta Pixel ID (can also be configured via Admin Settings in dashboard)
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# Meta Conversions API Server Access Token (System User Token)
META_CAPI_TOKEN=

# ------------------------------------------------------------------------------
# 6. ANALYTICS & ERROR MONITORING
# ------------------------------------------------------------------------------
# Google Analytics Measurement ID (Format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Sentry DSN for error logging (Server & Client)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
